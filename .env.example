# Database
DATABASE_URL=postgresql+asyncpg://lunair:CHANGE_ME@localhost:5432/lunair
POSTGRES_USER=lunair
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lunair

# Redis
REDIS_URL=redis://localhost:6379/0

# Providers — REPLACE WITH YOUR KEYS LOCALLY
OPENAI_API_KEY=sk-REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
GROQ_API_KEY=REPLACE_ME
# Optional, for balance lookups (management key for OpenRouter).
OPENROUTER_API_KEY=REPLACE_ME
DEEPSEEK_API_KEY=REPLACE_ME

# Security
SEPTR_API_KEY=REPLACE_ME
# Shared secret between the Go gateway and the core. MUST be changed and MUST
# match on both services. The core refuses the trusted-header path without it.
GATEWAY_SHARED_SECRET=dev-insecure-shared-secret-change-me
# Admin key for the key-management API (/v1/keys). Leave blank to disable it.
LUNAIR_ADMIN_KEY=
# Local-development auth bypass. MUST stay false outside development.
DEV_AUTH_BYPASS=false

# Gateway
GATEWAY_MODE=go
FASTAPI_URL=http://localhost:8000
GATEWAY_PORT=8080
GATEWAY_READ_TIMEOUT_SECONDS=60
GATEWAY_IDLE_TIMEOUT_SECONDS=120
GATEWAY_AUTH_CACHE_SECONDS=60

# Limits & budgets
RATE_LIMIT_FAIL_CLOSED=true
BUDGET_ENFORCEMENT=true
UPSTREAM_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=120
PARTITION_MONTHS_AHEAD=3

# Dashboard
DASHBOARD_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RETENTION_DAYS=30

# Frontend
VITE_API_URL=http://localhost:8080
